{
  "name": "orquesta-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orquesta backend lambdas, shared domain/ports, and PostgreSQL schema",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:pg": "TEST_DB=pg node --test test/*.test.js",
    "test:all": "npm test && npm run test:pg",
    "lint": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down -v",
    "load:checkin": "node load/checkin-load.js",
    "load:import": "node load/import-load.js",
    "dev": "node dev/server.js",
    "seed": "node dev/seed.js"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  }
}
